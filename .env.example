# Copy ke .env lalu isi
DISCORD_TOKEN=isi_token_bot_discord_di_sini

# Fitur /summary (via 9router, API OpenAI-compatible)
# NINE_ROUTER_API_KEY=isi_api_key_9router_di_sini
# NINE_ROUTER_BASE_URL=https://router.joysi.my.id/v1
# NINE_ROUTER_MODEL=ag/gemini-3.8-flash-high
# Batas teks dokumen yang dikirim ke AI (default: 60000 karakter)
# SUMMARY_MAX_INPUT_CHARS=60000

# Opsional (default: 20MB, limit Discord gratis per file)
# MAX_FILE_BYTES=20971520
# Batas ukuran file yang diproses server (default: 100MB)
# MAX_PROCESS_BYTES=104857600
