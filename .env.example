# Copy to .env and fill in
DISCORD_TOKEN=your_discord_bot_token_here

# /summary feature (via 9router, OpenAI-compatible API)
# NINE_ROUTER_API_KEY=your_9router_api_key_here
# NINE_ROUTER_BASE_URL=https://router.joysi.my.id/v1
# NINE_ROUTER_MODEL=ag/gemini-3.8-flash-high
# Max document text sent to the AI (default: 60000 characters)
# SUMMARY_MAX_INPUT_CHARS=60000

# Optional (default: 20MB, Discord's free per-file limit)
# MAX_FILE_BYTES=20971520
# Max file size the server will process (default: 100MB)
# MAX_PROCESS_BYTES=104857600
